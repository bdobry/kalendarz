{
  "name": "nierobie.pl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-school-breaks.mjs && vite build && vite build --ssr entry-server.tsx --outDir .ssr && node scripts/prerender.mjs && node scripts/verify-seo.mjs && node scripts/verify-timezones.mjs",
    "preview": "vite preview",
    "assets:icons": "node scripts/share-assets.mjs --icons-only public",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "data:school": "node scripts/sync-school-breaks.mjs",
    "data:school:check": "node scripts/sync-school-breaks.mjs --strict"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.0",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
